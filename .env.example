APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# APP_URL is a CLI/queue fallback only. Web URLs are derived from each incoming request
# (localhost, ngrok, production domain) via SetRequestRootUrl middleware.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Local SQLite tuning (reduces "database is locked" during dev)
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=wal
# Production: never use sqlite — switch to MySQL/PostgreSQL
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=linkedempire
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local dev (Windows): database queue + `composer dev` runs one worker for all queues.
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
# Production / Horizon (requires Redis + Linux/WSL — Horizon does not run on native Windows PHP):
# QUEUE_CONNECTION=redis
# REDIS_QUEUE_RETRY_AFTER=900

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Horizon (queue dashboard at /horizon — Linux/WSL/production)
HORIZON_PATH=horizon

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Get your exact DSN URL from your Unipile dashboard (Settings → API)
# Format: https://api{N}.unipile.com:{PORT}/api/v1
# IMPORTANT: api1.unipile.com is only an example — each account has its own DSN.
UNIPILE_BASE_URL=https://api1.unipile.com:13111/api/v1
UNIPILE_API_KEY=
UNIPILE_WEBHOOK_SECRET=
UNIPILE_MOCK=true
UNIPILE_ACCOUNT_ID_PARAM=query
UNIPILE_ENDPOINT_HOSTED_AUTH_LINK=/hosted/accounts/link
UNIPILE_ENDPOINT_LIST_ACCOUNTS=/accounts
UNIPILE_ENDPOINT_SEARCH=/linkedin/search
UNIPILE_ENDPOINT_SEND_INVITATION=/users/invite
UNIPILE_ENDPOINT_START_CHAT=/chats
UNIPILE_ENDPOINT_SEND_MESSAGE=/chats/%s/messages

# ── Unipile pacing & per-user daily caps (anti-spam / account safety) ──
# Caps of 0 mean unlimited. When a cap is reached, queued actions
# auto-defer to the next day and the user sees a toast.
UNIPILE_DAILY_INVITE_CAP=40
UNIPILE_DAILY_NEW_CHAT_CAP=60
UNIPILE_DAILY_MESSAGE_CAP=200
# Bulk "start all chats": seconds between queued chats + random jitter
UNIPILE_CHAT_LAUNCH_STAGGER_SECONDS=8
UNIPILE_CHAT_LAUNCH_JITTER_SECONDS=7
# Random pause (ms) between chained profile lookups (email enrichment)
UNIPILE_PROFILE_LOOKUP_DELAY_MIN_MS=1000
UNIPILE_PROFILE_LOOKUP_DELAY_MAX_MS=3000
# Random pause (ms) between paginated harvest calls (competitor engagers)
UNIPILE_HARVEST_PAGE_DELAY_MIN_MS=800
UNIPILE_HARVEST_PAGE_DELAY_MAX_MS=2500
# Daily email enrichment lookups per user
DAILY_EMAIL_SCRAPING_LIMIT=100
# Max leads queued per Enrich / Prepare click (Leads, Competitors, Outreach, CSV import)
EMAIL_ENRICHMENT_BATCH_SIZE=25
# Optional override for outreach prepare only (defaults to EMAIL_ENRICHMENT_BATCH_SIZE)
# OUTREACH_CONTACT_PREP_BATCH_SIZE=25
FULLENRICH_API_KEY=

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
CLOUDINARY_URL=
RAPIDAPI_KEY=

JVZOO_SECRET=
PLATFORM_ADMIN_EMAILS=admin@gmail.com
BILLING_REQUIRE_ENTITLEMENT=false

# Ops alerting (optional — Slack incoming webhook for queue/limit/webhook failures)
OPS_SLACK_WEBHOOK_URL=
OPS_ALERT_DAILY_LIMITS=true
OPS_ALERT_QUEUE_HEALTH=true
OPS_ALERT_FAILED_JOBS_THRESHOLD=10

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_URL=http://127.0.0.1:5173

# ── Platform channel toggles (Integrations, outreach, unified inbox) ──
CHANNEL_LINKEDIN_ENABLED=true
CHANNEL_EMAIL_ENABLED=true
CHANNEL_WHATSAPP_ENABLED=true
CHANNEL_INSTAGRAM_ENABLED=true
CHANNEL_TELEGRAM_ENABLED=false
CHANNEL_TWITTER_ENABLED=false
CHANNEL_GOOGLE_CALENDAR_ENABLED=true
CHANNEL_OUTLOOK_CALENDAR_ENABLED=true

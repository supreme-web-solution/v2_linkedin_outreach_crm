<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="CommandCenterNightly">
            <file>tests/Unit/V2/Ai/UserTurnIntentServiceTest.php</file>
            <file>tests/Unit/V2/Ai/PromptObservabilityServiceTest.php</file>
            <file>tests/Unit/V2/Ai/ProspectAudienceResolverServiceTest.php</file>
            <file>tests/Unit/V2/Ai/AgentOrchestratorAutoLaunchGuardTest.php</file>
            <file>tests/Unit/V2/Ai/CommandCenterControlCommandTest.php</file>
            <file>tests/Unit/V2/Ai/CommandCenterHistoryWindowTest.php</file>
            <file>tests/Unit/V2/Ai/WebChatTurnProgressServiceTest.php</file>
            <file>tests/Unit/V2/Ai/WebChatProgressReplyTest.php</file>
            <file>tests/Unit/V2/Ai/ContentPostCommandCenterServiceTest.php</file>
            <file>tests/Unit/V2/Ai/LeadNurtureCommandCenterServiceTest.php</file>
            <file>tests/Feature/Web/AiEmployeeWebChatQueueTest.php</file>
            <file>tests/Feature/Console/PromptRegressionWeeklyCommandTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
